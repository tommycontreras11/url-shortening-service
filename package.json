{
  "name": "url-shortening-service",
  "version": "1.0.0",
  "description": "A RESTful URL shortening service built with Node.js, Express, TypeScript, and PostgreSQL. Supports creating, retrieving, updating, and deleting short URLs, with randomly generated short codes and access statistics.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typeorm": "tsx ./node_modules/typeorm/cli.js -d ./src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "keywords": [],
  "author": "Tommy Contreras",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.24.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
